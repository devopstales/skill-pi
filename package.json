{
  "name": "@devopstales/skill-pi",
  "version": "0.1.0",
  "description": "A pi-based coding agent with bundled extensions, fully isolated from stock pi installs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "skill-pi": "bin/skill-pi.js",
    "skill-pi-version": "bin/skill-pi-version.js"
  },
  "files": [
    "bin",
    "lib",
    "defaults",
    "docs",
    "extensions",
    "skills",
    ".skillgrid",
    "SYSTEM.md"
  ],
  "dependencies": {
    "@devopstales/pi-mnemonic": "^0.1.1",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@effect/platform-node": "^4.0.4",
    "@effect/platform-node-shared": "^4.0.4",
    "@pierre/diffs": "^1.1.15",
    "@pierre/theme": "^0.0.29",
    "effect": "^4.0.4",
    "minimatch": "^10.2.3",
    "tree-sitter-bash": "^0.25.1",
    "typebox": "1.3.27",
    "web-tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "jiti": "^2.7.0",
    "node-pty": "^1.1.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devopstales/skill-pi.git"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "wrapper",
    "isolated"
