{
  "name": "@devopstales/pi-plan-build",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Plan/Build modes for pi with a persistent plan, explicit approval, clean-session handoff, and step-by-step execution, drawn as a card in the skill-pi-tui sidebar. Based on janvitos's pi-plan-build (MIT).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devopstales/skill-pi.git"
  },
  "homepage": "https://github.com/devopstales/skill-pi",
  "bugs": {
    "url": "https://github.com/devopstales/skill-pi/issues"
  },
  "keywords": [
    "pi",
    "extension",
    "coding-agent",
    "plan-mode",
    "plan-build",
    "task-list"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "typebox": "*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": "*",
    "@devopstales/skill-pi": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@devopstales/skill-pi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0"
  }
}
