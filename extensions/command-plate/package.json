{
  "name": "@devopstales/pi-command-plate",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "A Ctrl+K command plate (which-key style leader palette) for pi, with scoped-model and full model/thinking pickers. Based on tomsej's pi-ext leader-key (MIT).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devopstales/skill-pi.git"
  },
  "homepage": "https://github.com/devopstales/skill-pi",
  "bugs": {
    "url": "https://github.com/devopstales/skill-pi/issues"
  },
  "keywords": [
    "pi",
    "extension",
    "coding-agent",
    "leader-key",
    "command-palette",
    "model-switcher"
  ],
  "files": [
    "index.ts",
    "*.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": "*",
    "@devopstales/skill-pi": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@devopstales/skill-pi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0"
  }
}
